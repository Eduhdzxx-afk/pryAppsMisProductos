<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rotation="0"
    tools:context=".Vista.LoginActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="151dp"
        android:layout_height="37dp"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif-black"
        android:hyphenationFrequency="none"
        android:justificationMode="none"
        android:text="Iniciar Sesión"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/txtUsuario"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="@+id/txtUsuario"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtUsuario"
        android:layout_width="256dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#A2A2A2"
        android:drawableTint="#A2A2A2"
        android:ems="7"
        android:inputType="text"
        android:shadowColor="#A2A2A2"
        android:text="Nombre de usuario"
        android:textColor="#C7C7C7"
        android:textColorLink="#A2A2A2"
        app:layout_constraintBottom_toTopOf="@+id/txtClave"
        app:layout_constraintEnd_toEndOf="@+id/txtClave"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtClave"
        app:layout_constraintTop_toBottomOf="@+id/txtTitulo"
        app:layout_constraintVertical_bias="0.673" />

    <EditText
        android:id="@+id/txtClave"
        android:layout_width="259dp"
        android:layout_height="36dp"
        android:layout_marginBottom="40dp"
        android:ems="10"
        android:inputType="textPassword"
        android:text="contraseña"
        android:textColor="#C7C7C7"
        app:layout_constraintBottom_toTopOf="@+id/btnLogin"
        app:layout_constraintEnd_toEndOf="@+id/btnLogin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/btnLogin" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="260dp"
        android:layout_height="55dp"
        android:text="Ingresar"
        tools:layout_editor_absoluteX="80dp"
        tools:layout_editor_absoluteY="274dp" />
</androidx.constraintlayout.widget.ConstraintLayout>